<entity name="Account">
  <base_methods>
    <method name="Throw" exposed="own_client" reply="int32" />
    <method name="BadAsyncReply" exposed="own_client" reply="list[int32]" />
    <method name="Echo" exposed="own_client" reply="int32">
      <arg name="value" type="int32" />
    </method>
    <method name="DelayedEcho" exposed="own_client" reply="int32">
      <arg name="value" type="int32" />
      <arg name="delayMs" type="int32" />
    </method>
    <method name="Reject" exposed="own_client" reply="int32" />
    <method name="Notify" exposed="own_client">
      <arg name="value" type="int32" />
    </method>
    <method name="ReadNotification" exposed="own_client" reply="int32" />
    <method name="AttachProbe" exposed="own_client" reply="uint32" />
    <method name="HandoffLocation" exposed="own_client" reply="list[uint64]" />
    <method name="HandoffClient" exposed="own_client" reply="int32">
      <arg name="entityId" type="uint32" />
      <arg name="baseIp" type="uint32" />
      <arg name="basePort" type="uint16" />
      <arg name="instance" type="uint64" />
    </method>
  </base_methods>
</entity>
