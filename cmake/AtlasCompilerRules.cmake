if(MSVC AND CMAKE_GENERATOR MATCHES "Ninja")
  set(_include_compiler "${CMAKE_CXX_COMPILER}")
  if(NOT _include_compiler)
    set(_include_compiler "${CMAKE_C_COMPILER}")
  endif()
  set(_include_probe "${CMAKE_BINARY_DIR}/CMakeFiles/atlas-include-probe")
  file(WRITE "${_include_probe}.h" "\n")
  file(WRITE "${_include_probe}.c" "#include \"atlas-include-probe.h\"\n")
  execute_process(COMMAND "${_include_compiler}" /nologo /showIncludes /Zs "${_include_probe}.c"
    OUTPUT_VARIABLE _include_output RESULT_VARIABLE _include_result ENCODING NONE)
  string(REGEX MATCH "(^|[\r\n])([^\r\n]+: +)[A-Za-z]:[/\\\\]" _include_match "${_include_output}")
  if(NOT _include_result EQUAL 0 OR NOT _include_match)
    message(FATAL_ERROR "Could not detect the MSVC include prefix for Ninja dependency tracking")
  endif()
  set(_include_prefix "${CMAKE_MATCH_2}")
  if(EXISTS "${CMAKE_BINARY_DIR}/.ninja_deps")
    file(READ "${CMAKE_BINARY_DIR}/CMakeFiles/rules.ninja" _include_rules)
    string(FIND "${_include_rules}" "msvc_deps_prefix = ${_include_prefix}\n" _include_position)
    if(_include_position EQUAL -1)
      message(FATAL_ERROR "MSVC header dependency metadata is unreliable; use a fresh --build-dir")
    endif()
  endif()
  # Ninja matches compiler bytes; console decoding can corrupt localized prefixes.
  set(CMAKE_CL_SHOWINCLUDES_PREFIX "${_include_prefix}")
  set(CMAKE_C_CL_SHOWINCLUDES_PREFIX "${_include_prefix}")
  set(CMAKE_CXX_CL_SHOWINCLUDES_PREFIX "${_include_prefix}")
endif()
